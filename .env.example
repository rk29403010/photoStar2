# API Keys - DO NOT COMMIT REAL KEYS HERE
# Copy this file to .env and fill in your values

# Service API Keys
VITE_API_KEY=

# Optional explicit dev port overrides
# Main workspace defaults: 5173 / 5174
# Worktrees under .worktrees/<name> get stable automatic offsets unless you override them here
VITE_PORT=5173
VITE_BACKEND_PORT=5174
