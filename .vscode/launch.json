{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Web Dev (Vite UI + Core + Chrome Debug)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:desktop-runtime"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "Local:\\s+(https?://\\S+)",
                "webRoot": "${workspaceFolder}"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "🖥️ Desktop Dev (Tauri + WS Core)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:desktop"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "🧩 Desktop Runtime (UI + Core + Chrome Debug)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:desktop-runtime"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "Local:\\s+(https?://\\S+)",
                "webRoot": "${workspaceFolder}"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "🧪 Desktop Runtime (Verbose HMR Logs)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:desktop-runtime:debug"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "Local:\\s+(https?://\\S+)",
                "webRoot": "${workspaceFolder}"
            },
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "🧹 Kill Dev Ports",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:kill-ports"
            ],
            "console": "integratedTerminal"
        }
    ]
}
