{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "description": "High-level image type or category.",
      "nullable": false
    },
    "caption": {
      "type": "string",
      "description": "Short one-line summary of the photo.",
      "nullable": false
    },
    "description": {
      "type": "string",
      "description": "Fuller narrative description of the photo.",
      "nullable": false
    },
    "estimated_date": {
      "type": "object",
      "properties": {
        "most_likely_date": {
          "type": "string",
          "description": "Most likely ISO date or a coarse year/decade string.",
          "nullable": true
        },
        "min_date": {
          "type": "string",
          "description": "Earliest plausible ISO date for the photo.",
          "nullable": true
        },
        "max_date": {
          "type": "string",
          "description": "Latest plausible ISO date for the photo.",
          "nullable": true
        },
        "display_label": {
          "type": "string",
          "description": "Human-readable label for the estimated date range.",
          "nullable": false
        },
        "rationale": {
          "type": "string",
          "description": "Short explanation for the chosen date range.",
          "nullable": true
        }
      },
      "required": [
        "most_likely_date",
        "min_date",
        "max_date",
        "display_label",
        "rationale"
      ]
    },
    "location": {
      "type": "string",
      "description": "Estimated location or Unknown.",
      "nullable": false
    },
    "subjects": {
      "type": "array",
      "description": "Detected people or pets in the image.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Unique subject label such as Subject1.",
            "nullable": false
          },
          "bounding_box": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Left position in the full original photo on a normalized 0 to 1000 grid."
              },
              "y": {
                "type": "number",
                "description": "Top position in the full original photo on a normalized 0 to 1000 grid."
              },
              "width": {
                "type": "number",
                "description": "Width in the full original photo on a normalized 0 to 1000 grid."
              },
              "height": {
                "type": "number",
                "description": "Height in the full original photo on a normalized 0 to 1000 grid."
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "source_image_index": {
            "type": "number",
            "description": "Image part index: 1 for overview, 2-5 for detail crop, or null if unknown.",
            "nullable": true
          },
          "bounding_box_coordinate_space": {
            "type": "string",
            "description": "Bounding-box coordinate space: full_photo or crop_local.",
            "nullable": true
          },
          "type": {
            "type": "string",
            "description": "Subject type such as person or pet.",
            "nullable": false
          },
          "location_desc": {
            "type": "string",
            "description": "Relative position of the subject within the image.",
            "nullable": false
          },
          "gender": {
            "type": "string",
            "description": "Estimated gender, or unknown when unclear.",
            "nullable": true
          },
          "animal_type": {
            "type": "string",
            "description": "Animal type for pets when present.",
            "nullable": true
          },
          "age_range": {
            "type": "string",
            "description": "Estimated age range.",
            "nullable": true
          },
          "dob_range": {
            "type": "string",
            "description": "Estimated birth decade or range.",
            "nullable": true
          },
          "emotion": {
            "type": "string",
            "description": "Estimated emotion.",
            "nullable": true
          },
          "gaze": {
            "type": "string",
            "description": "Estimated gaze direction.",
            "nullable": true
          },
          "features": {
            "type": "string",
            "description": "Distinctive visible features.",
            "nullable": true
          },
          "uniform": {
            "type": "string",
            "description": "Uniform or notable clothing if present.",
            "nullable": true
          },
          "suggested_names": {
            "type": "array",
            "description": "Potential names suggested by the image or filename context.",
            "items": {
              "type": "string",
              "description": "Suggested person or pet name.",
              "nullable": false
            }
          }
        },
        "required": [
          "label",
          "bounding_box",
          "type",
          "location_desc",
          "gender",
          "animal_type",
          "age_range",
          "dob_range",
          "emotion",
          "gaze",
          "features",
          "uniform",
          "suggested_names"
        ]
      }
    },
    "regions_of_interest": {
      "type": "array",
      "description": "Important detail regions that matter for archive research.",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Short label for the region of interest.",
            "nullable": false
          },
          "kind": {
            "type": "string",
            "description": "Region kind such as signage, handwriting, clothing, vehicle, architecture, or object.",
            "nullable": false
          },
          "bounding_box": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "description": "Left position in the full original photo on a normalized 0 to 1000 grid."
              },
              "y": {
                "type": "number",
                "description": "Top position in the full original photo on a normalized 0 to 1000 grid."
              },
              "width": {
                "type": "number",
                "description": "Width in the full original photo on a normalized 0 to 1000 grid."
              },
              "height": {
                "type": "number",
                "description": "Height in the full original photo on a normalized 0 to 1000 grid."
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "source_image_index": {
            "type": "number",
            "description": "Image part index: 1 for overview, 2-5 for detail crop, or null if unknown.",
            "nullable": true
          },
          "bounding_box_coordinate_space": {
            "type": "string",
            "description": "Bounding-box coordinate space: full_photo or crop_local.",
            "nullable": true
          },
          "significance": {
            "type": "string",
            "description": "Why the region matters for archive analysis.",
            "nullable": true
          }
        },
        "required": [
          "label",
          "kind",
          "bounding_box",
          "significance"
        ]
      }
    },
    "keywords": {
      "type": "array",
      "description": "Approved canonical tags chosen from the provided vocabulary.",
      "items": {
        "type": "string",
        "description": "Keyword.",
        "nullable": false
      }
    },
    "tag_proposals": {
      "type": "array",
      "description": "Candidate new tags for useful concepts missing from the approved canonical vocabulary.",
      "items": {
        "type": "string",
        "description": "Tag proposal.",
        "nullable": false
      }
    },
    "emotional_impact": {
      "type": "string",
      "description": "Summary of the image mood or emotional impact.",
      "nullable": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "technical": {
          "type": "number",
          "description": "Technical quality score."
        },
        "lighting": {
          "type": "number",
          "description": "Lighting quality score."
        },
        "composition": {
          "type": "number",
          "description": "Composition quality score."
        },
        "emotional": {
          "type": "number",
          "description": "Emotional resonance score."
        },
        "discard": {
          "type": "boolean",
          "description": "Whether this image should likely be discarded."
        }
      },
      "required": [
        "technical",
        "lighting",
        "composition",
        "emotional",
        "discard"
      ]
    },
    "recommended_enhancements": {
      "type": "array",
      "description": "Recommended restoration or enhancement actions.",
      "items": {
        "type": "string",
        "description": "Enhancement suggestion.",
        "nullable": false
      }
    },
    "authenticity": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "description": "Estimated authenticity score."
        },
        "reasons": {
          "type": "array",
          "description": "Reasons supporting the authenticity estimate.",
          "items": {
            "type": "string",
            "description": "Authenticity reason.",
            "nullable": false
          }
        }
      },
      "required": [
        "score",
        "reasons"
      ]
    }
  },
  "required": [
    "type",
    "caption",
    "description",
    "estimated_date",
    "location",
    "subjects",
    "regions_of_interest",
    "keywords",
    "tag_proposals",
    "emotional_impact",
    "quality",
    "recommended_enhancements",
    "authenticity"
  ]
}
