{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "outDir": "./dist",
        "incremental": true,
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
        "rootDir": "..",
        "strict": true,
        "esModuleInterop": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "./src/**/*.ts",
        "../shared/**/*.ts"
    ],
    "exclude": [
        "./dist",
        "./node_modules",
        "../node_modules",
        "../src-tauri/target",
        "../.git",
        "../.vscode",
        "../.idea"
    ],
    "watchOptions": {
        "watchFile": "useFsEventsOnParentDirectory",
        "watchDirectory": "useFsEvents",
        "fallbackPolling": "dynamicPriority",
        "excludeDirectories": [
            "./dist",
            "./node_modules",
            "../node_modules",
            "../src-tauri/target",
            "../.git",
            "../.vscode",
            "../.idea"
        ]
    }
}
