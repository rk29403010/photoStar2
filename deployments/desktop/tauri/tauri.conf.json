{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "photo-star-2",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../../../dist/web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:desktop:prep"
  },
  "app": {
    "windows": [
      {
        "title": "Photo Library",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "C:/Users/robin/AppData/Roaming/PhotoLibraryDesktop/**",
          "**"
        ]
      },
      "capabilities": [
        "sidecar-allow"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/core"
    ]
  }
}
