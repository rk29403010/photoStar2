{
  "name": "photo-star-2",
  "private": true,
  "version": "0.1.45",
  "type": "module",
  "scripts": {
    "🚀dev": "tauri dev",
    "dev:ui": "vite",
    "dev:ui:desktop": "vite --mode desktop-dev",
    "dev:core": "cd core && npm run dev",
    "prepare": "node scripts/install-git-hooks.mjs",
    "predev": "node scripts/kill-ports.js",
    "dev": "concurrently --names ui,core --prefix-colors cyan.bold,magenta.bold \"npm run dev:ui\" \"npm run dev:core\"",
    "predev:desktop-runtime": "node scripts/kill-ports.js",
    "dev:desktop-runtime": "concurrently --names ui,core --prefix-colors cyan.bold,magenta.bold \"npm run dev:ui:desktop\" \"npm run dev:core\"",
    "dev:desktop": "tauri dev --config src-tauri/tauri.desktop-dev.conf.json",
    "build": "npm run quality && vite build",
    "build:core": "node core/scripts/smart_build.js",
    "tauri:dev-pre": "npm run build:core && npm run dev:ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fast": "oxlint -c .oxlintrc.json .",
    "lint:fast:fix": "oxlint -c .oxlintrc.json --fix .",
    "lint:staged": "node scripts/lint-changed-files.mjs --staged",
    "fix:staged": "node scripts/lint-changed-files.mjs --staged --fix",
    "lint:fast:staged": "node scripts/lint-changed-files.mjs --staged --tool=oxlint",
    "fix:fast:staged": "node scripts/lint-changed-files.mjs --staged --tool=oxlint --fix",
    "lint:changed": "node scripts/lint-changed-files.mjs --changed",
    "fix:changed": "node scripts/lint-changed-files.mjs --changed --fix",
    "lint:fast:changed": "node scripts/lint-changed-files.mjs --changed --tool=oxlint",
    "fix:fast:changed": "node scripts/lint-changed-files.mjs --changed --tool=oxlint --fix",
    "complexity:report": "node scripts/complexity-report.js",
    "complexity:staged": "node scripts/complexity-changed-files.mjs --staged",
    "complexity:changed": "node scripts/complexity-changed-files.mjs --changed",
    "typecheck": "tsc -b --pretty false",
    "typecheck:core": "npx tsc -p core/tsconfig.json --noEmit --pretty false",
    "quality": "npm run lint:fast && npm run lint && npm run typecheck && npm run typecheck:core && npm run lint:md && npm run complexity:report -- --top 20 --min-cyclomatic 10",
    "quality:fix": "npm run lint:fast:fix && npm run lint:fix && npm run fix:md",
    "quality:staged": "npm run fix:fast:staged && npm run fix:staged && npm run lint:fast:staged && npm run lint:staged && npm run complexity:staged",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore core/node_modules --ignore src-tauri/target",
    "fix:md": "markdownlint \"**/*.md\" --fix --ignore node_modules --ignore core/node_modules --ignore src-tauri/target",
    "predev:desktop-runtime:debug": "node scripts/kill-ports.js",
    "dev:ui:debug": "vite --debug hmr",
    "dev:fast-loop": "npm run dev:desktop-runtime:debug",
    "dev:desktop-runtime:debug": "concurrently --names ui,core --prefix-colors cyan.bold,magenta.bold \"npm run dev:ui:debug\" \"npm run dev:core\""
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.18.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-oxlint": "^1.51.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "markdownlint-cli": "^0.47.0",
    "oxlint": "^1.51.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.14",
    "vite-plugin-checker": "^0.12.0"
  }
}
