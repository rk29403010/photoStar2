{
  "name": "photo-star-2",
  "private": true,
  "version": "0.1.45",
  "type": "module",
  "scripts": {
    "postinstall": "node tooling/scripts/core/fix_tfjs_binding.cjs",
    "prepare": "node tooling/scripts/repo/install-git-hooks.mjs",
    "dev:web": "vite",
    "dev:web:desktop": "vite --mode desktop-dev",
    "dev:web:debug": "vite --debug hmr",
    "dev:core": "node tooling/scripts/core/dev-watch.cjs",
    "dev:kill-ports": "node tooling/scripts/repo/kill-ports.js",
    "dev": "concurrently --names web,core --prefix-colors cyan.bold,magenta.bold \"npm run dev:web\" \"npm run dev:core\"",
    "dev:desktop-runtime": "concurrently --names web,core --prefix-colors cyan.bold,magenta.bold \"npm run dev:web:desktop\" \"npm run dev:core\"",
    "dev:desktop-runtime:debug": "concurrently --names web,core --prefix-colors cyan.bold,magenta.bold \"npm run dev:web:debug\" \"npm run dev:core\"",
    "dev:fast-loop": "npm run dev:desktop-runtime:debug",
    "dev:impact": "node tooling/scripts/repo/dev-runtime-impact.js --changed",
    "dev:desktop": "node tooling/scripts/repo/run-tauri-dev.js",
    "build": "npm run quality && npm run build:web",
    "build:web": "vite build",
    "build:core:ts": "tsc -p tooling/config/tsconfig.core.json --pretty false && node tooling/scripts/core/post-compile.cjs",
    "build:core": "node tooling/scripts/core/smart_build.cjs --compile-only",
    "package:core": "pkg dist/core/src/entrypoints/core/main.js --targets node18-win-x64 --output deployments/desktop/tauri/binaries/core-x86_64-pc-windows-msvc",
    "build:desktop:prep": "npm run build:web && npm run build:core && npm run package:core",
    "build:desktop": "tauri build --config deployments/desktop/tauri/tauri.conf.json",
    "download:models": "node tooling/scripts/core/download_nsfw_model.cjs",
    "start:core": "node dist/core/src/entrypoints/core/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fast": "oxlint -c .oxlintrc.json .",
    "lint:fast:fix": "oxlint -c .oxlintrc.json --fix .",
    "lint:staged": "node tooling/scripts/repo/lint-changed-files.mjs --staged",
    "fix:staged": "node tooling/scripts/repo/lint-changed-files.mjs --staged --fix",
    "lint:fast:staged": "node tooling/scripts/repo/lint-changed-files.mjs --staged --tool=oxlint",
    "fix:fast:staged": "node tooling/scripts/repo/lint-changed-files.mjs --staged --tool=oxlint --fix",
    "lint:changed": "node tooling/scripts/repo/lint-changed-files.mjs --changed",
    "fix:changed": "node tooling/scripts/repo/lint-changed-files.mjs --changed --fix",
    "lint:fast:changed": "node tooling/scripts/repo/lint-changed-files.mjs --changed --tool=oxlint",
    "fix:fast:changed": "node tooling/scripts/repo/lint-changed-files.mjs --changed --tool=oxlint --fix",
    "complexity:report": "node tooling/scripts/repo/complexity-report.js",
    "complexity:staged": "node tooling/scripts/repo/complexity-changed-files.mjs --staged",
    "complexity:changed": "node tooling/scripts/repo/complexity-changed-files.mjs --changed",
    "typecheck": "tsc -b --pretty false",
    "typecheck:core": "tsc -p tooling/config/tsconfig.core.json --noEmit --pretty false",
    "quality": "npm run lint:fast && npm run lint && npm run typecheck && npm run typecheck:core && npm run lint:md && npm run complexity:report -- --top 20 --min-cyclomatic 10",
    "quality:fix": "npm run lint:fast:fix && npm run lint:fix && npm run fix:md",
    "quality:staged": "npm run fix:fast:staged && npm run fix:staged && npm run lint:fast:staged && npm run lint:staged && npm run complexity:staged",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:md": "markdownlint \"**/*.md\"",
    "fix:md": "markdownlint \"**/*.md\" --fix --ignore node_modules --ignore deployments/desktop/tauri/target"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@xyflow/react": "^12.10.1",
    "better-sqlite3": "^11.10.0",
    "exif-parser": "^0.1.12",
    "fs-extra": "^11.2.0",
    "lucide-react": "^0.575.0",
    "nsfwjs": "^4.2.1",
    "onnxruntime-node": "^1.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.18.1",
    "sharp": "^0.33.5",
    "uuid": "^11.0.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.9.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-oxlint": "^1.51.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "markdownlint-cli": "^0.47.0",
    "oxlint": "^1.51.0",
    "pkg": "^5.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsc-watch": "^7.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.14",
    "vite-plugin-checker": "^0.12.0"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/onnxruntime_binding.node",
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/onnxruntime.dll",
      "node_modules/@tensorflow/tfjs-node/lib/napi-v8/tfjs_binding.node",
      "node_modules/@tensorflow/tfjs-node/lib/napi-v8/tensorflow.dll",
      "node_modules/@img/**/*",
      "node_modules/sharp/**/*",
      "deployments/common/models/*.onnx",
      "deployments/common/models/nsfwjs/**/*"
    ]
  }
}
