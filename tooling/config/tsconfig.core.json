{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../../dist/core/src",
    "rootDir": "../../src",
    "incremental": true,
    "tsBuildInfoFile": "../../dist/core/.tsbuildinfo",
    "baseUrl": "../../",
    "strict": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@ui/*": ["src/ui/*"],
      "@boundary/*": ["src/boundary/*"],
      "@contracts/*": ["src/boundary/contracts/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "../../src/boundary/contracts/**/*.ts",
    "../../src/boundary/transport/devBridge*.ts",
    "../../src/data/**/*.ts",
    "../../src/entrypoints/core/**/*.ts",
    "../../src/services/**/*.ts",
    "../../src/shared/**/*.ts"
  ],
  "exclude": [
    "../../dist",
    "../../node_modules",
    "../../deployments/desktop/tauri/target",
    "../../.git",
    "../../.vscode",
    "../../.idea"
  ],
  "watchOptions": {
    "watchFile": "useFsEventsOnParentDirectory",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority",
    "excludeDirectories": [
      "../../dist",
      "../../node_modules",
      "../../deployments/desktop/tauri/target",
      "../../.git",
      "../../.vscode",
      "../../.idea"
    ]
  }
}
